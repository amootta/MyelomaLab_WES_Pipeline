// Combined UCL Myriad execution config for acg-team/nextflow-pvacseq (v1.0.0)
//
// = nf-core/configs' ucl_myriad.config, reproduced verbatim from
//   https://github.com/nf-core/configs/blob/master/conf/ucl_myriad.config
//   (SGE executor + per-cpu memory + singularity/apptainer settings)
// + three fixes for failures already hit running this pipeline on this cluster:
//   the apptainer-module-load workaround for intermittent "env: singularity: No
//   such file or directory" (exit 127, same as WES_tumor_batch1/mgp1000);
//   pointing the container pull cache at Scratch instead of $HOME to avoid the
//   "Disk quota exceeded" failure hit during mgp1000 preprocessing; and
//   --cleanenv + unsetting PERL5LIB/LD_LIBRARY_PATH to stop SGE's environment
//   passthrough leaking a host-loaded Perl/OpenSSL into VEP's container, which
//   was causing "SSLeay.c: loadable library and perl binaries are mismatched"
//   inside SETUP_VEP_ENVIRONMENT/ENSEMBLVEP_DOWNLOAD (vep_install crashing
//   before printing any output).
//
// WHY THIS FILE EXISTS: nextflow-pvacseq's own nextflow.config carries leftover
// nf-core-template custom_config_base/custom_config_version params but never
// actually includes nf-core/configs' nfcore_custom.config, so -profile ucl_myriad
// is undefined for this pipeline (confirmed against the pipeline's real
// nextflow.config on GitHub) even though it works for sarek. This file replaces
// that profile with the same settings, passed explicitly via -c.
//
// USAGE (no -profile ucl_myriad, no -profile singularity/apptainer needed --
// this file already turns singularity on):
//
//   nextflow run nextflow-pvacseq-v.1.0.0/main.nf \
//     --max_time 40h \
//     -c myriad_pvacseq.config \
//     --input ./COS_004_003_PRG_consensus.vcf \
//     --hla_csv HLA_pvacseq_COS_004_003.csv \
//     --fasta /myriadfs/home/regma03/Scratch/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa \
//     --outdir .
//
// NOT YET VERIFIED AGAINST Amatta's REAL myriad_extra.config -- I only have that
// file's contents as described secondhand (module loads, the mosdepth cpu cap,
// etc.), not its literal text. If her real file has more in it that's relevant
// to this pipeline, merge it in / pass both: -c myriad_pvacseq.config -c myriad_extra.config

params {
    config_profile_description = 'University College London Myriad cluster'
    config_profile_contact     = 'Chris Wyatt (ucbtcdr@ucl.ac.uk), Fernando Duarte (f.frutos@ucl.ac.uk)'
    config_profile_url         = 'https://www.rc.ucl.ac.uk/docs/Clusters/Myriad/'
}

executor {
    name            = 'sge'
    queueSize       = 100     // cap jobs sent to qsub at once
    submitRateLimit = '10/1s' // ease pressure on the scheduler
}

process {
    penv    = 'smp'
    scratch = false

    // Fix for "env: singularity: No such file or directory" (exit 127) -- hit on
    // WES_tumor_batch1 (BWAMEM1_MEM, COS_003_009_PBMC) and on the mgp1000 somatic
    // run. Root cause: apptainer isn't reliably a system package on every Myriad
    // exec node, even though /usr/bin/singularity -> apptainer exists on some
    // (confirmed on node-t00a-006). Loading the module explicitly makes the
    // `singularity` binary Nextflow calls available regardless of which node
    // SGE schedules the task onto.
    //
    // The PERL5LIB/LD_LIBRARY_PATH unsets are belt-and-suspenders for the
    // SSLeay/Perl-OpenSSL mismatch fix in singularity.runOptions below
    // (--cleanenv should already stop these leaking into the container, but
    // SGE clones the *entire* submitting shell environment -- confirmed
    // previously via a probe job with -S /bin/bash and no module loads still
    // showing the full module-populated PATH -- so belt-and-braces against
    // whatever's module-loaded in the shell this pipeline gets launched from).
    //
    // The conda unsets/deactivate are the same category of fix for a
    // *different* leaked-environment failure: "conda: command not found" /
    // "/bin/activate: No such file or directory" at the SGE job-script level,
    // before the container (or vep_install) even starts -- confirmed NOT
    // coming from this pipeline or the nf-core ENSEMBLVEP_DOWNLOAD module
    // itself (its script{} block has no conda logic at all). Most likely
    // cause: a conda-init block in her Myriad login shell (she set conda up
    // there in Aug 2026) exports a `conda` shell function/related vars that
    // SGE clones into the job, and something invokes it expecting a working
    // PATH/CONDA_EXE that isn't actually there in the job's non-interactive
    // context. `conda deactivate` is wrapped in `|| true` since the function
    // may not even exist in the job shell.
    //
    // Failure 4 (2026-09-08): "no space left on device" while pulling the
    // griffithlab/pvactools:6.0.5 image for CONFIGURE_PVACSEQ -- Apptainer
    // unpacks OCI layers into a build-temp dir under $TMPDIR before writing
    // the final .sif, and Myriad's per-job $TMPDIR
    // (/tmpdir/job/<jobid>.undefined/) is small local disk on the compute
    // node, unrelated to the singularity.cacheDir fix above (that only
    // controls where the *finished* .sif is cached, not where layers get
    // unpacked during the pull itself).
    //
    // CORRECTION (2026-09-08, after 2 failed reruns with this beforeScript
    // fix in place): the assumption that this pull runs inside the task's own
    // SGE job was WRONG. The full stack trace showed work-dir=null for the
    // failing task and a call chain through TaskProcessor.createTaskHashKey ->
    // ContainerHandler.createSingularityCache -> SingularityCache -- i.e.
    // Nextflow pulls a missing image as part of computing the task's hash key,
    // as a direct subprocess of the NEXTFLOW HEAD PROCESS itself, before the
    // task is ever submitted to SGE. beforeScript never had a chance to touch
    // this -- it only applies to actual per-task job scripts. The real fix has
    // to set TMPDIR/APPTAINER_TMPDIR/SINGULARITY_TMPDIR in whatever
    // shell/script launches `nextflow run` itself (Amatta's submission script,
    // right next to her `module load apptainer` line), not in this config.
    // Left the exports below in place anyway since they're harmless and still
    // correct for any container pull that DOES happen inside a real per-task
    // job elsewhere in this pipeline.
    beforeScript = '''
        module load apptainer
        unset PERL5LIB
        unset LD_LIBRARY_PATH
        conda deactivate 2>/dev/null || true
        unset CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_EXE CONDA_PYTHON_EXE CONDA_SHLVL _CE_M _CE_CONDA
        mkdir -p "$HOME/Scratch/.apptainer/tmp"
        export APPTAINER_TMPDIR="$HOME/Scratch/.apptainer/tmp"
        export SINGULARITY_TMPDIR="$HOME/Scratch/.apptainer/tmp"
        # APPTAINER_TMPDIR/SINGULARITY_TMPDIR alone did NOT fix failure 4 --
        # rerun failed identically (new job id, same /tmpdir/job/<id>.undefined/
        # build-temp path). SGE itself pre-sets $TMPDIR to that small local
        # path for every job (confirmed convention, see mgp1000 notes), and
        # the failing step ("Copying blob...", "Converting OCI blobs to SIF
        # format") is the containers/image Go library's OCI-pull path, not
        # Apptainer's native build path -- that library defaults to the
        # generic $TMPDIR rather than deferring to the Apptainer-specific
        # override, so SGE's pre-set value was winning. Overriding $TMPDIR
        # itself here (which is safe -- redirecting a job's scratch space to
        # larger-quota storage is standard HPC practice, not just for this
        # one tool) is the actual fix.
        export TMPDIR="$HOME/Scratch/.apptainer/tmp"
    '''.stripIndent()

    // Verbatim from nf-core/configs' ucl_myriad.config: SGE wants memory
    // requested per-cpu, not per-job, so divide task.memory by task.cpus.
    clusterOptions = {
        def mem = task.memory.mega
        def cpus = task.cpus
        def memoryPerCpu = mem / cpus
        "-S /bin/bash -l mem=${memoryPerCpu}M"
    }
}

// Confirmed root cause of failure 3 (2026-09-08): the "# conda environment" /
// `source $(conda info --json...)/bin/activate .../work/conda/env-...` block
// in the generated .command.run is Nextflow's own standard template -- it
// only appears when conda.enabled is true. Neither this file nor the
// pipeline's own nextflow.config/base.config sets that (verified: the
// pipeline only sets it inside its unused conda/mamba profile blocks), so it
// must be coming from Amatta's own environment -- most likely
// ~/.nextflow/config (Nextflow auto-loads this for every run, any pipeline)
// or a leftover nextflow.config in mgp1000's directory tree if this is being
// launched from inside/near it (Nextflow also auto-includes a nextflow.config
// from the launch directory). Rather than track down which, override the key
// directly here -- this file's -c has higher precedence than both of those.
conda.enabled = false

singularity {
    enabled    = true
    autoMounts = true
    // Fix for the "Disk quota exceeded" failure hit during mgp1000 preprocessing
    // (writing into $HOME) -- keep the apptainer/singularity pull cache under
    // Scratch, which has the larger quota, instead of the default under $HOME.
    cacheDir   = "${System.getenv('HOME')}/Scratch/.apptainer/pull"
    // Base binds/mounts verbatim from ucl_myriad.config: binds $HOME and $PWD,
    // and explicitly excludes Myriad's generic local /scratch mount (unrelated
    // to the ~/Scratch filesystem her data/reference actually live under --
    // that's covered by the $HOME bind since her paths are all under
    // /myriadfs/home/regma03/Scratch/...).
    //
    // --cleanenv added (not in the upstream ucl_myriad.config): Apptainer/
    // Singularity pass the host's environment into the container by default,
    // and SGE on Myriad exports the *entire* submitting shell's environment to
    // every job. If that shell has anything module-loaded that sets
    // LD_LIBRARY_PATH/PERL5LIB, it leaks into VEP's container and its Perl
    // loads the host's libssl instead of the container's own -- exactly the
    // "SSLeay.c: loadable library and perl binaries are mismatched" crash.
    // --cleanenv stops the passthrough (Nextflow still injects the specific
    // task env vars it needs itself, so this doesn't break task execution).
    runOptions = "-B ${System.getenv('HOME')},${System.getenv('PWD')} --no-mount /scratch --writable-tmpfs --cleanenv"

    // Failure 4 continued (2026-09-09): after the submission-script-level
    // TMPDIR export was applied, the symptom changed from status 255 ("no
    // space left on device") to status 143 (SIGTERM) on the griffithlab/
    // pvactools:6.0.5 pull -- and the log now shows
    // "Deleting file collector temp dir: $HOME/Scratch/.apptainer/tmp/nxf-...",
    // proving the pull is actually unpacking onto Scratch now, not the small
    // local /tmpdir. So the disk-space problem is gone; what's killing the
    // pull now is Nextflow's own singularity.pullTimeout, which every one of
    // these errors has been hinting at (default "20m") -- Scratch is
    // NFS-backed network storage, and unpacking pvactools:6.0.5's many layers
    // (only one "info unpack layer" line had printed before the SIGTERM) onto
    // NFS is far slower than the local disk the timeout was tuned for.
    // Raised to 2 hours; adjust further if a rerun still times out (check the
    // job's wall time against this value before assuming a new failure mode).
    pullTimeout = '120.min'
}

// Housekeeping: without these, a rerun from the same directory aborts at the
// very end trying to re-render pipeline_info/execution_report_*.html and
// execution_timeline_*.html because the previous attempt's files are still
// there. Harmless to the actual pipeline logic, just noisy on retries.
report.overwrite = true
timeline.overwrite = true

// Failure 6 (2026-09-10): PVACSEQ_SUMMARY hardcodes container
// 'jupyter/scipy-notebook:python-3.11.8' in the pipeline's own
// modules/local/summary/main.nf (confirmed on GitHub) -- that exact tag has
// since been pruned from the jupyter/scipy-notebook repo, so the pull fails
// immediately with "manifest unknown" (categorically different from the
// slow-pull/timeout failures above: no amount of retrying or pre-pulling a
// nonexistent tag ever helps -- only pointing at a tag that actually exists
// does). 'python-3.11' (no patch suffix) does exist on Docker Hub, hence the
// override below.
//
// Failure 7 (2026-09-11): the first version of this override just said
// container = 'jupyter/scipy-notebook:python-3.11', and Nextflow silently
// resolved it against quay.io instead of Docker Hub -- pulling
// "docker://quay.io/jupyter/scipy-notebook:python-3.11" and caching it as
// quay.io-jupyter-scipy-notebook-python-3.11.img. Root cause: this
// pipeline's own nextflow.config (confirmed on GitHub) sets
// apptainer.registry / docker.registry / podman.registry /
// singularity.registry all to 'quay.io' as its global default, and that
// default is applied to ANY container reference that doesn't already carry
// an explicit registry host -- including a withName override written
// without one. quay.io has no jupyter/scipy-notebook repo at all (confirmed
// via web search -- Docker Hub is the only place this image exists), so
// left alone this override would eventually fail the same "manifest
// unknown" way as failure 6, just slower (quay.io still has to be queried
// and time out/error before Nextflow gives up). Fix: qualify the registry
// explicitly with a 'docker.io/' prefix -- Nextflow treats any first path
// segment containing a '.' as an already-specified registry host and skips
// the config-default substitution for it.
process {
    withName: 'PVACSEQ_SUMMARY' {
        container = 'docker.io/jupyter/scipy-notebook:python-3.11'
    }
}

// NOT included yet, add only if needed: a global process.cpus/memory cap.
// Sarek's BWAMEM1_MEM hardcoded cpus=24 in a way that bypassed its own
// check_max() and caused unschedulable job requests on Myriad, requiring a
// `withName` override (see [[sarek-wes-myriad]]). nextflow-pvacseq's own
// modules haven't been audited for the same issue -- if a job fails to
// schedule with a "no place to run this job" JSV-style error, add:
//
//   process {
//       withName: '<offending process name from the error>' {
//           cpus = 8
//       }
//   }