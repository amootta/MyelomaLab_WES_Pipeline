# =============================================================================
# pipeline.config -- the ONE place to set paths for a batch.
#
# Every stage sources this file. Nothing else in the repo should contain a
# hardcoded path. To run a second batch, copy this file, change BATCH_DIR and
# SAMPLES, and pass it with:   PIPELINE_CONFIG=/path/to/copy ./wes.sh ...
#
# On Myriad, $HOME == /myriadfs/home/<user>, so $HOME/Scratch is your Scratch.
# Reference files live on the RDSS:
#   /rdss/rd02/ritd-ag-project-rd028n-amira43/reference_files
#   /rdss/rd02/ritd-ag-project-rd028n-amira43/Shared_Scripts   (tool installs)
# =============================================================================

# ---- batch -------------------------------------------------------------------
BATCH_NAME=WES_tumor_batch1
BATCH_DIR=$HOME/Scratch/$BATCH_NAME           # every stage writes under here
SAMPLES=$PIPELINE_DIR/config/samples.tsv      # master sample sheet
EMAIL=regma03@ucl.ac.uk                       # nextflow completion emails

# ---- where each stage writes -------------------------------------------------
# sarek was originally run with --outdir ./ inside BATCH_DIR, so its
# preprocessing/ and variant_calling/ folders sit directly in BATCH_DIR.
SAREK_DIR=$BATCH_DIR
BAM_DIR=$SAREK_DIR/preprocessing/recalibrated/bams   # cram->bam conversions (stage 01); where batch1's bams already are
MUTECT2_DIR=$BATCH_DIR/mutect2_filtered       # FilterMutectCalls + Funcotator
MGP1000_DIR=$HOME/Scratch/mgp1000             # mgp1000 install + its output/
MGP1000_SOMATIC_DIR=$MGP1000_DIR/output/somatic
# mgp1000's union consensus tables, one subfolder per pair:
#   consensus/<T>_vs_<N>/<T>_vs_<N>.hq.union.consensus.somatic.snv.txt.gz
MGP1000_CONSENSUS_GLOB="$MGP1000_SOMATIC_DIR/consensus/*/*.hq.union.consensus.somatic.snv.txt.gz"
CONSENSUS_DIR=$BATCH_DIR/consensus            # stage 03
HLA_DIR=$BATCH_DIR/HLA                        # stage 04
KIR_DIR=$BATCH_DIR/KIR                        # stage 05
IGCALLER_DIR=$BATCH_DIR/IgCaller              # stage 06
PVACSEQ_DIR=$BATCH_DIR/pvacseq                # stage 07
PYCLONE_DIR=$BATCH_DIR/pyclone                # stage 08
SAMPLESHEET_DIR=$BATCH_DIR/samplesheets       # generated tool-specific sheets
LOG_DIR=$BATCH_DIR/logs                       # SGE .o/.e files

# ---- reference genome (GRCh38, chr-prefixed, no alt) ---------------------------
REF_FASTA=$HOME/Scratch/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa
REF_FAI=$REF_FASTA.fai

# ---- sarek / GATK resources --------------------------------------------------
DBSNP=$HOME/Scratch/funcotator_dataSources.v1.8.hg38.20230908s/dbsnp/hg38/hg38_All_20180418.vcf.gz
KNOWN_INDELS=$HOME/Scratch/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz
GNOMAD_AF=$HOME/Scratch/af-only-gnomad.hg38.vcf.gz
PON=$HOME/Scratch/somatic-hg38_1000g_pon.hg38.vcf
FUNCOTATOR_DS=$HOME/Scratch/funcotator_dataSources.v1.7.20200521s
ASCAT_LOCI=$HOME/Scratch/battenberg_reference/1000G_loci_hg38/battenberg_loci_on_target_hg38/battenberg_loci_on_target_hg38.zip
ASCAT_ALLELES=$HOME/Scratch/battenberg_reference/1000G_loci_hg38/battenberg_alleles_on_target_hg38/battenberg_alleles_on_target_hg38.zip
ASCAT_LOCI_GC=$HOME/Scratch/GC_G1000_on_target_hg38.txt.zip
ASCAT_LOCI_RT=$HOME/Scratch/RT_G1000_on_target_hg38.txt.zip
MAPPABILITY=$HOME/Scratch/out100m2_hg38.gem
CONTROLFREEC_CHR_DIR=$HOME/Scratch/chrfiles_controlfreec
SAREK_TOOLS=mutect2,ascat,cnvkit,strelka,manta
SAREK_VERSION=3.8.1                           # what WES_tumor_batch1 ran (with Nextflow 25.10.4)

# ---- software ----------------------------------------------------------------
JAVA_MODULE=java/temurin-17/17.0.2_8
APPTAINER_MODULE=apptainer
PYTHON_MODULE=python3/recommended             # has pandas + openpyxl for bin/*.py
R_MODULE=r                                    # needs data.table + ggplot2
CONDA_SH=$HOME/Scratch/miniforge3/etc/profile.d/conda.sh
APPTAINER_CACHE=$HOME/Scratch/.apptainer     # pull cache + tmp (keeps $HOME under quota)

MGP1000_NXF_VER=22.10.8                       # mgp1000 needs this older nextflow
MGP1000_APPTAINER_MODULES="apptainer/1.2.4-1 singularity-env/1.0.0"
MGP1000_SINGULARITY_CACHE=$HOME/Scratch/singularity_cache   # mgp1000's images are already pulled here
MGP1000_INPUT_DIR=$BATCH_DIR/mgp1000_input    # bams (hard links) that mgp1000 reads via --input_dir
MGP1000_RUN_ID=$BATCH_NAME
# Which somatic tools mgp1000 runs (from mgp1000_WES.sh). igcaller here is
# mgp1000's own IgCaller run; stage 06 runs IgCaller separately.
MGP1000_SOMATIC_TOOLS="--battenberg off --manta on --delly on --svaba off --igcaller on --varscan on --mutect on --strelka on --conpair off --fragcounter off --telomerecat off --telomerehunter off --caveman off"

T1K_DIR=$HOME/Scratch/WES_tumor_batch1/HLA/T1K-1.0.10   # unzip from RDSS; has hlaidx/ and kiridx/
KIRCLE_DIR=$HOME/Scratch/KIRCLE               # unzip from RDSS; has KIRCLE/ and ref_files/
HLAHD_TARBALL=$HOME/Scratch/hlahd.1.7.1.tar.gz # from RDSS, for nf-core/hlatyping
HLATYPING_DIR=$HOME/Scratch/hlatyping-patched # patched nf-core/hlatyping checkout, run with `nextflow run .`

IGCALLER_HOME=$HOME/Scratch/IgCaller          # folder holding the IgCaller script + IgCaller_reference_files/
IGCALLER_SAMTOOLS=$HOME/bin/samtools_wrapper

PVACSEQ_PIPELINE=$MGP1000_SOMATIC_DIR/consensus/nextflow-pvacseq-v.1.0.0/main.nf
PVACSEQ_IEDB=$MGP1000_SOMATIC_DIR/consensus/iedb
PVACSEQ_VEP_PLUGINS=$MGP1000_SOMATIC_DIR/consensus/download/VEP_plugins
PVACSEQ_ALGORITHMS="MHCflurry MHCnuggetsI NetMHC"
PVACSEQ_PROFILE=conda                         # what last ran; myriad_pvacseq.config's conda.enabled=false
                                              # overrides it, so tasks still run in containers

# ---- optional: ground-truth typing for the concordance reports -----------------
HLA_TRUTH=""                                  # xlsx/csv, see bin/hla_concordance.py --truth-template
KIR_TRUTH=""                                  # csv; blank = the 6 samples embedded in kir_concordance.py

# ---- analysis choices ----------------------------------------------------------
HLA_SOURCE_FOR_PVACSEQ=optitype               # optitype | t1k | hlahd -- whose class I calls feed pVACseq
CONSENSUS_MIN_CALLERS=2                       # mgp1000 consensus: PASS in >= N of mutect/strelka/varscan
